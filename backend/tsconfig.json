{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "types": ["node"],        // 🔑 IMPORTANT
    "incremental": false
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}




